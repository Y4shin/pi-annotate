node_modules/
# dist/ is generated by the build and ignored, EXCEPT the pi-annotate
# extension's runtime CSS bundle (client.ts reads it at import time). Ship
# that one tracked artifact so `pi install` (no build step) loads cleanly;
# keep the rest of dist/ (preview.html etc.) ignored. gitignore cannot
# re-include a file under an excluded directory, so exclude dist contents
# (dist/**) rather than the directory itself, then un-ignore the one asset.
dist/**
!dist/annotate.css
*.log
.DS_Store

# The pi-annotate extension's own dist subdir: same rule — ignore generated
# preview.html, keep the runtime CSS bundle tracked.
.pi/extensions/pi-annotate/dist/**
!.pi/extensions/pi-annotate/dist/annotate.css

# Impeccable design tooling (per-environment, not project source).
# The .agents/ skill is installed by the upstream Impeccable package;
# .impeccable/ holds generated design artifacts, decision payloads,
# live-mode session state, and review screenshots.
.agents/
.impeccable/
