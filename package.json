{
  "name": "pi-annotate",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./.pi/extensions/pi-annotate/index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "vitest run",
    "check": "tsc --noEmit",
    "build:css": "tailwindcss -i .pi/extensions/pi-annotate/styles.css -o .pi/extensions/pi-annotate/dist/annotate.css --minify",
    "build:preview": "node .pi/extensions/pi-annotate/preview.mjs",
    "build": "npm run build:css && npm run build:preview",
    "test:e2e": "playwright test --config playwright.config.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@earendil-works/pi-tui": "0.80.10",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "26.2.0",
    "daisyui": "^5.7.19",
    "tailwindcss": "^4.3.3",
    "typebox": "1.1.38",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "@playwright/test": "1.61.1"
  }
}
